#!/bin/bash
set -euo pipefail

declare -A SOURCES=(
  ["hagezi-pro"]="https://ctif.hagezi.org/blocklists/rpz/pro.txt"
  ["hagezi-tif"]="https://ctif.hagezi.org/blocklists/rpz/tif.txt"
)

RPZ_DIR="/etc/powerdns/rpz"
STATE_DIR="/var/lib/dnsbunker/rpz-state"   # ein ETag-File pro Source

mkdir -p "$STATE_DIR"

reload_needed=false

# Lädt eine URL conditional per ETag (If-None-Match).
# Rückgabe: 0 = geändert (neu heruntergeladen), 1 = unverändert (304), 2 = Fehler
fetch_url() {
  local url="$1" etag_file="$2" out_file="$3"
  local etag_tmp
  etag_tmp="$(mktemp)"

  touch "$etag_file"

  local http_code="" curl_exit=0
  http_code=$(curl -sSL \
    --etag-compare "$etag_file" \
    --etag-save "$etag_tmp" \
    -o "$out_file" \
    -w '%{http_code}' \
    "$url") || curl_exit=$?

  if [ "$curl_exit" -ne 0 ]; then
    echo "  [error] curl fehlgeschlagen (exit $curl_exit) für $url" >&2
    rm -f "$etag_tmp"
    return 2
  fi

  case "$http_code" in
    200)
      if [ -s "$etag_tmp" ]; then
        mv "$etag_tmp" "$etag_file"
      else
        rm -f "$etag_tmp"
        : > "$etag_file"
      fi
      echo "  [changed]   $url"
      return 0
      ;;
    304)
      rm -f "$etag_tmp"
      echo "  [unchanged] $url"
      return 1
      ;;
    *)
      echo "  [error] HTTP $http_code für $url" >&2
      rm -f "$etag_tmp"
      return 2
      ;;
  esac
}

for name in "${!SOURCES[@]}"; do
  echo "== $name =="
  url="${SOURCES[$name]}"
  etag_file="${STATE_DIR}/${name}.etag"
  tmp="$(mktemp)"

  rc=0
  fetch_url "$url" "$etag_file" "$tmp" || rc=$?

  if [ "$rc" -eq 1 ]; then
    echo "[$name] keine Änderung"
    rm -f "$tmp"
    continue
  elif [ "$rc" -eq 2 ]; then
    echo "[$name] Fehler beim Abruf, überspringe" >&2
    rm -f "$tmp"
    continue
  fi

  if ! head -n 20 "$tmp" | grep -q "SOA"; then
    echo "[$name] Kein SOA-Record gefunden, breche ab" >&2
    rm -f "$tmp"
    continue
  fi

  size=$(stat -c%s "$tmp")
  if [ "$size" -lt 100000 ]; then
    echo "[$name] Datei verdächtig klein ($size bytes), breche ab" >&2
    rm -f "$tmp"
    continue
  fi

  mv "$tmp" "${RPZ_DIR}/${name}.rpz"
  echo "[$name] aktualisiert"
  reload_needed=true
done

chown -R pdns:pdns "$RPZ_DIR"

if $reload_needed; then
  rec_control --timeout=60 reload-lua-config
  echo "Lua-Config neu geladen (mind. eine RPZ-Datei aktualisiert)"
else
  echo "Keine RPZ-Änderungen, PowerDNS Recursor nicht neu geladen"
fi